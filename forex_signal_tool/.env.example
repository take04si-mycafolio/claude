# Database (MySQL / MariaDB)
# 形式: mysql+pymysql://ユーザー名:パスワード@ホスト/DB名?charset=utf8mb4
DATABASE_URL=mysql+pymysql://xs539690_forex:your_password@localhost/xs539690_forex?charset=utf8mb4

# Alpha Vantage API
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key

# Flask
SECRET_KEY=your_random_secret_key_here
FLASK_ENV=production

# Email settings (Gmail SMTP例)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=your_email@gmail.com
REPORT_RECIPIENTS=recipient@example.com
